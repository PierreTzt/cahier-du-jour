# Copier en `.env` sur le serveur et remplir. Ce fichier-ci est versionné,
# `.env` ne l'est jamais.

# Le domaine qui pointe vers le serveur. Caddy s'en sert pour obtenir le
# certificat, donc il doit résoudre AVANT le premier démarrage.
# Plusieurs adresses sont acceptées, séparées par des virgules — Caddy sert
# l'apex et le www d'un seul bloc. Les guillemets comptent : ce fichier est
# lu par Docker Compose ET sourcé par un shell.
DOMAINE="votre-domaine.fr, www.votre-domaine.fr"

# Vide avec un vrai domaine : Caddy obtient et renouvelle le certificat
# tout seul chez Let's Encrypt.
# `"tls internal"` seulement pour un essai sur un nom d'hôte qui ne peut pas
# avoir de certificat public (le navigateur affichera un avertissement).
# Les guillemets comptent : sans eux, le shell qui source ce fichier essaie
# d'exécuter « internal » et la sauvegarde avorte avant de commencer.
CADDY_TLS=

# La base. Garder `cahier` pour les deux premières lignes : les scripts de
# `deploiement/` s'y attendent. Le mot de passe ne sort jamais de la machine :
# la base n'a aucun port publié, elle n'est joignable que depuis la pile.
POSTGRES_DB=cahier
POSTGRES_USER=cahier
POSTGRES_PASSWORD=

# Phrase de chiffrement des sauvegardes. À conserver AILLEURS que sur le
# serveur — une sauvegarde chiffrée dont la clé est sur la machine perdue ne
# sert à rien.
SAUVEGARDE_PHRASE=

# Destination des sauvegardes hors de l'hébergeur, au format rclone
# (`rclone config`). Tant que cette ligne est vide, la copie reste sur la
# machine qu'elle est censée protéger.
SAUVEGARDE_DESTINATION=
